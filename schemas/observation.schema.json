{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glitchscout.com/schemas/v1/observation.schema.json",
  "title": "Observation",
  "description": "Game state snapshot. Every section is optional; the SDK sends the sections OBSERVE asked for. Interest management: entity arrays are sorted by distance and cut to OBSERVE.max_n, legal_actions keeps the game's order and is cut to max_n too, and an observation that would exceed the text-frame cap (manifest limits.max_text_frame_bytes, default 262144) is truncated (entities by distance, legal_actions from the end) and flagged truncated: true.",
  "type": "object",
  "properties": {
    "player": {
      "$ref": "#/$defs/player"
    },
    "interactables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interactable"
      }
    },
    "camera": {
      "$ref": "#/$defs/camera"
    },
    "threats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/threat"
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hazard"
      }
    },
    "ui_elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ui_element"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entity"
      }
    },
    "legal_actions": {
      "type": "array",
      "description": "The discrete moves the game would accept right now, in the game's order; perform one with CHOOSE. Ids are unique within the list. Sent only by engines whose manifest has supports.legal_actions. Never diffed: a STATE_UPDATE delta carries the whole list whenever it changed (an empty list when no move is legal) and leaves it out when it didn't.",
      "items": {
        "$ref": "#/$defs/legal_action"
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "True when entities or legal actions were dropped to fit the text-frame cap."
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "velocity": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "health": {
          "type": "number"
        },
        "max_health": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Health at full. Lets the bot work out health / max_health."
        },
        "state_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scene": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "position",
        "velocity"
      ],
      "additionalProperties": false
    },
    "interactable": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "affordance": {
          "enum": [
            "interact",
            "collect",
            "push"
          ],
          "description": "What the bot may do with it: interact (default), collect (a pickup to route through) or push (moved toward a plate, switch or ledge)."
        },
        "position": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "distance": {
          "type": "number",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "required_action": {
          "type": "string",
          "minLength": 1
        },
        "interaction_range": {
          "type": "number",
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "type",
        "position"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "position",
        "yaw",
        "pitch"
      ],
      "additionalProperties": false
    },
    "threat": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "distance": {
          "type": "number",
          "minimum": 0
        },
        "health": {
          "type": "number"
        },
        "attack_range": {
          "type": "number",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "position"
      ],
      "additionalProperties": false
    },
    "hazard": {
      "type": "object",
      "description": "A danger to path around: static (spikes, lava) or moving (projectiles, with velocity). radius is in engine units.",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "velocity": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "damage": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "position",
        "radius"
      ],
      "additionalProperties": false
    },
    "ui_element": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "focused": {
          "type": "boolean"
        },
        "rect": {
          "$ref": "common.schema.json#/$defs/rect"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "enabled",
        "visible"
      ],
      "additionalProperties": false
    },
    "legal_action": {
      "type": "object",
      "description": "One move the game would accept now.",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "Stable while the move stays legal; CHOOSE names it."
        },
        "kind": {
          "enum": [
            "card",
            "choice",
            "move",
            "buy",
            "end_turn",
            "ui",
            "custom"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "What a player sees, e.g. the card's name or the dialogue line."
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "description": "Entity ids the move can be aimed at. When present, CHOOSE must name one of them."
        },
        "cost": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Resource name \u2192 amount the move spends, e.g. {\"energy\": 1}."
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "description": "Where the move comes from, e.g. hand or shop."
        },
        "source": {
          "enum": [
            "provider",
            "ui"
          ],
          "default": "provider",
          "description": "provider: listed by the game's legal-actions provider; ui: built from enabled visible UI controls."
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
