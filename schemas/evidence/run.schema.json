{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glitchscout.com/schemas/v1/evidence/run.schema.json",
  "title": "run",
  "description": "runs/<run_id>/run.json: what one run of the agent tested and with which versions.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "pattern": "^glitchscout/[0-9]+$"
    },
    "orchestrator_version": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "$ref": "#/$defs/sha256_tagged"
    },
    "strategy_memory": {
      "type": "object",
      "description": "The strategy memory the run used: what the agent learned in earlier runs. A gating run uses a pinned read-only snapshot, so its decisions repeat; only exploratory and nightly runs write.",
      "properties": {
        "mode": {
          "enum": [
            "read_only",
            "read_write"
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/sha256_tagged",
          "description": "Digest of the snapshot the run started from."
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "The snapshot's version, which counts up each time it is written."
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "snapshot",
        "version",
        "entries"
      ],
      "additionalProperties": false
    },
    "reflection": {
      "type": "object",
      "description": "The reflection caps in force and what the run spent against them. When a cap is hit the remaining tests continue deterministically and are tagged reflection_unavailable; they are never failed.",
      "properties": {
        "per_test_cap": {
          "type": "integer",
          "minimum": 0
        },
        "per_run_cap": {
          "type": "integer",
          "minimum": 0
        },
        "per_suite_cap": {
          "type": "integer",
          "minimum": 0,
          "description": "Shared by every run of one CI invocation."
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "description": "Reflections this run asked the model for."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Reflections refused because a cap was reached."
        },
        "cap_hit": {
          "enum": [
            "run",
            "suite"
          ],
          "description": "The first run or suite cap that was reached; absent when none was."
        }
      },
      "required": [
        "per_test_cap",
        "per_run_cap",
        "per_suite_cap",
        "used",
        "skipped"
      ],
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "description": "Test ids selected for the run, in run order.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run_id",
    "started_at",
    "protocol",
    "orchestrator_version",
    "tests"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256_tagged": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
