{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glitchscout.com/schemas/v1/evidence/run.schema.json",
  "title": "run",
  "description": "runs/<run_id>/run.json: what one run of the agent tested and with which versions.",
  "type": "object",
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "build_id": { "type": "string", "minLength": 1 },
    "engine": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "sdk_version": { "type": "string", "minLength": 1 },
    "protocol": { "type": "string", "pattern": "^glitchscout/[0-9]+$" },
    "orchestrator_version": { "type": "string", "minLength": 1 },
    "config_hash": { "$ref": "#/$defs/sha256_tagged" },
    "tests": {
      "type": "array",
      "description": "Test ids selected for the run, in run order.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": ["run_id", "started_at", "protocol", "orchestrator_version", "tests"],
  "additionalProperties": false,
  "$defs": {
    "sha256_tagged": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
